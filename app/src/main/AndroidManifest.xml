<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions for App Locking -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.ACTION_MANAGE_OVERLAY_PERMISSION" />
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Camera for Intruder Selfie -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Storage for Intruder Selfie Photos -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32"/>
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28"/>

    <!-- Storage for Vault (Android 13+ granular media permissions) -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES"/>
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO"/>

    <!-- All Files Access for Vault (Android 11+) -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- Receive boot complete to auto-start protection -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Foreground service for app monitor -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Biometrics & Notifications -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Hardware features -->
    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <uses-feature android:name="android.hardware.camera.front" android:required="false"/>

    <application
        android:name=".AppLockerApp"
        android:allowBackup="true"
        android:icon="@drawable/applockappicon"
        android:label="@string/app_name"
        android:roundIcon="@drawable/applockappicon"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppLockerApp">

        <!-- Splash Screen Activity - NOT exported as LAUNCHER directly; aliases handle that -->
        <activity
            android:name=".presentation.splash.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.AppLockerApp.Splash"/>

        <!-- Interactive Onboarding Activity -->
        <activity
            android:name=".presentation.onboarding.OnboardingActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.AppLockerApp" />


        <!-- Main Activity - Single Activity Host -->
        <activity
            android:name=".presentation.MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.AppLockerApp" />

        <!-- Lock Setup Activity -->
        <activity
            android:name=".presentation.lock.LockSetupActivity"
            android:exported="false"
            android:theme="@style/Theme.AppLockerApp" />

        <!-- Language Selection Activity (Onboarding) -->
        <activity
            android:name=".presentation.lock.LanguageActivity"
            android:exported="false"
            android:theme="@style/Theme.AppLockerApp" />

        <!-- Security Question Setup Activity (Onboarding) -->
        <activity
            android:name=".presentation.lock.SecurityQuestionSetupActivity"
            android:exported="false"
            android:theme="@style/Theme.AppLockerApp" />

        <service
            android:name=".presentation.service.AppLockService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="App protection lock background monitoring service" />
        </service>

        <!-- Translucent Activity for Biometric Prompt hosting -->
        <activity
            android:name=".presentation.lock.BiometricAuthActivity"
            android:exported="false"
            android:theme="@style/Theme.AppLockerApp.Translucent" />

        <!-- Security Question Reset Activity -->
        <activity
            android:name=".presentation.lock.SecurityQuestionResetActivity"
            android:exported="false"
            android:theme="@style/Theme.AppLockerApp" />

        <!-- Translucent Activity for Widget auth prompt -->
        <activity
            android:name=".presentation.widget.WidgetAuthActivity"
            android:exported="false"
            android:theme="@style/Theme.AppLockerApp.Translucent" />

        <!-- Quick Lock/Unlock Home Widget Receiver -->
        <receiver
            android:name=".presentation.widget.AppLockWidgetProvider"
            android:exported="true"
            android:label="AppLock Quick Protection">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/app_lock_widget_info" />
        </receiver>

        <!-- Boot Receiver: Auto-starts AppLockService after device reboot -->
        <receiver
            android:name=".receiver.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </receiver>

        <!-- Icon Disguise Aliases - only one is enabled at a time via PackageManager -->
        <activity-alias
            android:name=".IconDefault"
            android:enabled="true"
            android:exported="true"
            android:label="@string/app_name"
            android:icon="@drawable/applockappicon"
            android:roundIcon="@drawable/applockappicon"
            android:targetActivity=".presentation.splash.SplashActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

