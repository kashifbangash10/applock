<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base App Theme (Dark overrides) -->
    <style name="Theme.AppLockerApp" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Brand Colors -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorSecondary">@color/primary_variant</item>
        <item name="colorAccent">@color/accent_color</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorSurface">@color/bg_surface</item>
        <item name="android:windowBackground">@color/bg_main</item>

        <!-- Status & Navigation Bar (Ensure status bar icons are light in Dark Mode) -->
        <item name="android:statusBarColor">@color/bg_main</item>
        <item name="android:navigationBarColor">@color/bg_main</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- Opt out of forced edge-to-edge on Android 15+ (API 35) -->
        <item name="android:windowOptOutEdgeToEdgeEnforcement" tools:targetApi="35">true</item>
    </style>

</resources>
