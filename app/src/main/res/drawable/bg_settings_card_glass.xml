<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- LAYER 1: Deep dark outer border shadow -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#020810" />
            <corners android:radius="20dp" />
        </shape>
    </item>

    <!-- LAYER 2: Frosted glass body with subtle blue gradient -->
    <item android:left="1dp" android:right="1dp" android:top="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#141F34"
                android:centerColor="#0D1826"
                android:endColor="#08101E" />
            <corners android:radius="19dp" />
        </shape>
    </item>

    <!-- LAYER 3: Inner white ring for glass shimmer effect -->
    <item android:left="2dp" android:right="2dp" android:top="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <stroke android:width="1dp" android:color="#18FFFFFF" />
            <corners android:radius="18dp" />
        </shape>
    </item>

    <!-- LAYER 4: Cyan glass border glow (outer) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <stroke android:width="1dp" android:color="#2538BDF8" />
            <corners android:radius="20dp" />
        </shape>
    </item>

</layer-list>
