<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- *** LOCKED STATE: Glowing cyan ring *** -->
    <item android:state_activated="true">
        <layer-list>
            <!-- Shadow base -->
            <item>
                <shape android:shape="oval">
                    <solid android:color="#010810" />
                </shape>
            </item>
            <!-- Cyan glow surface -->
            <item android:left="1dp" android:right="1dp" android:top="1dp" android:bottom="1dp">
                <shape android:shape="oval">
                    <gradient
                        android:type="radial"
                        android:gradientRadius="60%"
                        android:startColor="#1C3D5C"
                        android:endColor="#0B1E32" />
                    <stroke android:width="2dp" android:color="#38BDF8" />
                </shape>
            </item>
            <!-- Inner highlight dot -->
            <item android:left="10dp" android:right="10dp" android:top="5dp" android:bottom="18dp">
                <shape android:shape="oval">
                    <solid android:color="#2038BDF8" />
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- *** DEFAULT / UNLOCKED STATE: Subtle dark glass circle *** -->
    <item>
        <layer-list>
            <!-- Shadow base -->
            <item>
                <shape android:shape="oval">
                    <solid android:color="#010810" />
                </shape>
            </item>
            <!-- Dark glass surface -->
            <item android:left="1dp" android:right="1dp" android:top="1dp" android:bottom="1dp">
                <shape android:shape="oval">
                    <gradient
                        android:type="radial"
                        android:gradientRadius="60%"
                        android:startColor="#0F1E30"
                        android:endColor="#070E1C" />
                    <stroke android:width="1dp" android:color="#142540" />
                </shape>
            </item>
        </layer-list>
    </item>

</selector>
