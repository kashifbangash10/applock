<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- LAYER 1: Shadow Edge -->
    <item android:top="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#05101E" />
            <corners android:radius="18dp" />
        </shape>
    </item>

    <!-- LAYER 2: Dark Glass Steel Cyan Bordered Surface -->
    <item android:bottom="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#102540"
                android:centerColor="#0B1A2E"
                android:endColor="#071222" />
            <stroke
                android:width="1.5dp"
                android:color="#38BDF8" />
            <corners android:radius="18dp" />
        </shape>
    </item>

    <!-- LAYER 3: Subtle Top Glass Light Reflection -->
    <item android:left="6dp" android:right="6dp" android:top="2dp" android:bottom="4dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#2538BDF8"
                android:centerColor="#0538BDF8"
                android:endColor="#00000000" />
            <corners android:radius="16dp" />
        </shape>
    </item>

</layer-list>
