<?xml version="1.0" encoding="utf-8"?>
<!-- Animated Vault Icon for Onboarding Page 3 - Private Vault & Themes -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">

    <aapt:attr name="android:drawable">
        <vector
            android:width="80dp"
            android:height="80dp"
            android:viewportWidth="80"
            android:viewportHeight="80">

            <!-- Outer glow ring - Purple/Violet theme -->
            <group
                android:name="outer_ring"
                android:pivotX="40"
                android:pivotY="40"
                android:scaleX="1.0"
                android:scaleY="1.0"
                android:alpha="0.5">
                <path
                    android:fillColor="#228B5CF6"
                    android:pathData="M40,2 A38,38,0,1,1,39.99,2 Z" />
            </group>

            <!-- Vault door outer frame -->
            <path
                android:fillColor="#1A8B5CF6"
                android:strokeColor="#8B5CF6"
                android:strokeWidth="2"
                android:pathData="M14,14 Q13,14 13,15 L13,65 Q13,66 14,66 L66,66 Q67,66 67,65 L67,15 Q67,14 66,14 Z" />

            <!-- Vault door inner panel -->
            <path
                android:fillColor="#0F8B5CF6"
                android:strokeColor="#8B5CF6"
                android:strokeWidth="1.5"
                android:pathData="M20,20 Q19,20 19,21 L19,59 Q19,60 20,60 L60,60 Q61,60 61,59 L61,21 Q61,20 60,20 Z" />

            <!-- Vault wheel/handle outer ring -->
            <group
                android:name="vault_wheel"
                android:pivotX="40"
                android:pivotY="40">
                <path
                    android:fillColor="#158B5CF6"
                    android:strokeColor="#8B5CF6"
                    android:strokeWidth="2"
                    android:pathData="M40,40 m-16,0 a16,16,0,1,1,32,0 a16,16,0,1,1,-32,0" />

                <!-- Wheel spokes -->
                <path
                    android:fillColor="#00000000"
                    android:strokeColor="#8B5CF6"
                    android:strokeWidth="2"
                    android:pathData="M40,24 L40,32" />
                <path
                    android:fillColor="#00000000"
                    android:strokeColor="#8B5CF6"
                    android:strokeWidth="2"
                    android:pathData="M40,48 L40,56" />
                <path
                    android:fillColor="#00000000"
                    android:strokeColor="#8B5CF6"
                    android:strokeWidth="2"
                    android:pathData="M24,40 L32,40" />
                <path
                    android:fillColor="#00000000"
                    android:strokeColor="#8B5CF6"
                    android:strokeWidth="2"
                    android:pathData="M48,40 L56,40" />
                <!-- Diagonal spokes -->
                <path
                    android:fillColor="#00000000"
                    android:strokeColor="#8B5CF6"
                    android:strokeWidth="1.5"
                    android:pathData="M28.7,28.7 L33.4,33.4" />
                <path
                    android:fillColor="#00000000"
                    android:strokeColor="#8B5CF6"
                    android:strokeWidth="1.5"
                    android:pathData="M46.6,46.6 L51.3,51.3" />
                <path
                    android:fillColor="#00000000"
                    android:strokeColor="#8B5CF6"
                    android:strokeWidth="1.5"
                    android:pathData="M51.3,28.7 L46.6,33.4" />
                <path
                    android:fillColor="#00000000"
                    android:strokeColor="#8B5CF6"
                    android:strokeWidth="1.5"
                    android:pathData="M33.4,46.6 L28.7,51.3" />
            </group>

            <!-- Center lock knob -->
            <group
                android:name="center_knob"
                android:pivotX="40"
                android:pivotY="40">
                <path
                    android:fillColor="#8B5CF6"
                    android:pathData="M40,40 m-5,0 a5,5,0,1,1,10,0 a5,5,0,1,1,-10,0" />
                <path
                    android:fillColor="#B49EFF"
                    android:pathData="M40,40 m-2.5,0 a2.5,2.5,0,1,1,5,0 a2.5,2.5,0,1,1,-5,0" />
            </group>

            <!-- Vault handle on side -->
            <path
                android:fillColor="#00000000"
                android:strokeColor="#8B5CF6"
                android:strokeWidth="2.5"
                android:strokeLineCap="round"
                android:pathData="M61,33 L67,33 L67,47 L61,47" />

            <!-- Hinge dots left -->
            <path
                android:fillColor="#8B5CF6"
                android:pathData="M14,25 m-2.5,0 a2.5,2.5,0,1,1,5,0 a2.5,2.5,0,1,1,-5,0" />
            <path
                android:fillColor="#8B5CF6"
                android:pathData="M14,55 m-2.5,0 a2.5,2.5,0,1,1,5,0 a2.5,2.5,0,1,1,-5,0" />

            <!-- Glow dots -->
            <group android:name="glow_dot_1">
                <path
                    android:fillColor="#A78BFA"
                    android:pathData="M68,18 m-2,0 a2,2,0,1,1,4,0 a2,2,0,1,1,-4,0" />
            </group>
            <group android:name="glow_dot_2">
                <path
                    android:fillColor="#7C3AED"
                    android:pathData="M12,62 m-1.5,0 a1.5,1.5,0,1,1,3,0 a1.5,1.5,0,1,1,-3,0" />
            </group>

        </vector>
    </aapt:attr>

    <!-- Vault wheel slow rotation -->
    <target android:name="vault_wheel">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="rotation"
                android:valueFrom="0"
                android:valueTo="360"
                android:duration="8000"
                android:repeatCount="infinite"
                android:interpolator="@android:interpolator/linear" />
        </aapt:attr>
    </target>

    <!-- Outer ring pulse -->
    <target android:name="outer_ring">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator
                    android:propertyName="scaleX"
                    android:valueFrom="1.0"
                    android:valueTo="1.1"
                    android:duration="1500"
                    android:repeatCount="infinite"
                    android:repeatMode="reverse"
                    android:interpolator="@android:interpolator/accelerate_decelerate" />
                <objectAnimator
                    android:propertyName="scaleY"
                    android:valueFrom="1.0"
                    android:valueTo="1.1"
                    android:duration="1500"
                    android:repeatCount="infinite"
                    android:repeatMode="reverse"
                    android:interpolator="@android:interpolator/accelerate_decelerate" />
                <objectAnimator
                    android:propertyName="alpha"
                    android:valueFrom="0.5"
                    android:valueTo="0.9"
                    android:duration="1500"
                    android:repeatCount="infinite"
                    android:repeatMode="reverse"
                    android:interpolator="@android:interpolator/accelerate_decelerate" />
            </set>
        </aapt:attr>
    </target>

    <!-- Center knob pulse -->
    <target android:name="center_knob">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator
                    android:propertyName="scaleX"
                    android:valueFrom="1.0"
                    android:valueTo="1.3"
                    android:duration="600"
                    android:repeatCount="infinite"
                    android:repeatMode="reverse"
                    android:interpolator="@android:interpolator/accelerate_decelerate" />
                <objectAnimator
                    android:propertyName="scaleY"
                    android:valueFrom="1.0"
                    android:valueTo="1.3"
                    android:duration="600"
                    android:repeatCount="infinite"
                    android:repeatMode="reverse"
                    android:interpolator="@android:interpolator/accelerate_decelerate" />
            </set>
        </aapt:attr>
    </target>

    <!-- Glow dot 1 blink -->
    <target android:name="glow_dot_1">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="alpha"
                android:valueFrom="1.0"
                android:valueTo="0.2"
                android:duration="700"
                android:repeatCount="infinite"
                android:repeatMode="reverse"
                android:interpolator="@android:interpolator/accelerate_decelerate" />
        </aapt:attr>
    </target>

    <!-- Glow dot 2 blink offset -->
    <target android:name="glow_dot_2">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="alpha"
                android:valueFrom="0.2"
                android:valueTo="1.0"
                android:duration="700"
                android:repeatCount="infinite"
                android:repeatMode="reverse"
                android:interpolator="@android:interpolator/accelerate_decelerate" />
        </aapt:attr>
    </target>

</animated-vector>
