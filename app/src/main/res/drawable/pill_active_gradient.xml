<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- LAYER 1: Deep press shadow -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0B0E1A" />
            <corners android:radius="24dp" />
        </shape>
    </item>

    <!-- LAYER 2: Cyber Violet-Cyan gradient base -->
    <item android:bottom="3dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="0"
                android:startColor="#4338CA"
                android:centerColor="#0284C7"
                android:endColor="#06B6D4" />
            <stroke
                android:width="1dp"
                android:color="#80A5B4FC" />
            <corners android:radius="24dp" />
        </shape>
    </item>

    <!-- LAYER 3: Top gloss glass reflection -->
    <item android:left="6dp" android:right="6dp" android:top="2dp" android:bottom="4dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#40FFFFFF"
                android:centerColor="#10FFFFFF"
                android:endColor="#00FFFFFF" />
            <corners android:radius="18dp" />
        </shape>
    </item>

</layer-list>
