<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- LAYER 1: Ambient Cyber Glow Base -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0B0E1A" />
            <corners android:radius="24dp" />
        </shape>
    </item>

    <!-- LAYER 2: 3D Depth Shadow Edge -->
    <item android:bottom="3dp">
        <shape android:shape="rectangle">
            <solid android:color="#312E81" />
            <corners android:radius="24dp" />
        </shape>
    </item>

    <!-- LAYER 3: Electric Violet-Cyan Cyber Gradient Surface -->
    <item android:bottom="3dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="0"
                android:startColor="#4F46E5"
                android:centerColor="#2563EB"
                android:endColor="#06B6D4" />
            <stroke
                android:width="1.2dp"
                android:color="#80C7D2FE" />
            <corners android:radius="24dp" />
        </shape>
    </item>

    <!-- LAYER 4: Top Gloss Glass Light Reflection -->
    <item android:left="6dp" android:right="6dp" android:top="2dp" android:bottom="4dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#50FFFFFF"
                android:centerColor="#10FFFFFF"
                android:endColor="#00FFFFFF" />
            <corners android:radius="20dp" />
        </shape>
    </item>

</layer-list>
