<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Bottom 3D Shadow Base -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/btn_primary_shadow" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <!-- Top 3D Gradient Surface -->
    <item android:bottom="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="0"
                android:startColor="@color/btn_primary_gradient_start"
                android:endColor="@color/btn_primary_gradient_end" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</layer-list>
