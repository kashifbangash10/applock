<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base premium gradient -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:startColor="#0D47A1"
                android:centerColor="#1976D2"
                android:endColor="#FFD600"
                android:angle="225" />
        </shape>
    </item>
    <!-- Cyan neon accent glow -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="220dp"
                android:startColor="#6000E5FF"
                android:endColor="#00000000" />
        </shape>
    </item>
</layer-list>
