<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- LAYER 1: Shadow Edge -->
    <item android:top="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#014A75" />
            <corners android:radius="18dp" />
        </shape>
    </item>

    <!-- LAYER 2: 3D Steel Cyan Surface -->
    <item android:bottom="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#0284C7"
                android:centerColor="#0EA5E9"
                android:endColor="#38BDF8" />
            <stroke
                android:width="1.2dp"
                android:color="#BAE6FD" />
            <corners android:radius="18dp" />
        </shape>
    </item>

    <!-- LAYER 3: Gloss Light Reflection -->
    <item android:left="6dp" android:right="6dp" android:top="2dp" android:bottom="4dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#40FFFFFF"
                android:centerColor="#10FFFFFF"
                android:endColor="#00FFFFFF" />
            <corners android:radius="16dp" />
        </shape>
    </item>

</layer-list>
