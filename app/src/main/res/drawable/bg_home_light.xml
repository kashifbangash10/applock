<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Main light blue background -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#EAF5FF"/>
        </shape>
    </item>
    <!-- Soft blue glow at bottom -->
    <item
        android:top="500dp"
        android:left="-100dp"
        android:right="-100dp"
        android:bottom="-150dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:centerX="50%"
                android:centerY="50%"
                android:gradientRadius="350dp"
                android:startColor="#B8DEFF"
                android:endColor="#00FFFFFF"/>
        </shape>
    </item>
</layer-list>
