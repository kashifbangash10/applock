<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- LAYER 1: Deep shadow foundation -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#020810" />
            <corners android:radius="26dp" />
        </shape>
    </item>

    <!-- LAYER 2: Frosted glass gradient -->
    <item android:left="1dp" android:right="1dp" android:top="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#0F1E32"
                android:centerColor="#0A1628"
                android:endColor="#060E1A" />
            <corners android:radius="25dp" />
        </shape>
    </item>

    <!-- LAYER 3: Top shimmer highlight -->
    <item android:left="6dp" android:right="6dp" android:top="1dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#0D38BDF8"
                android:endColor="#0038BDF8" />
            <corners android:radius="22dp" />
        </shape>
    </item>

    <!-- LAYER 4: Cyan glow border -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <stroke android:width="1dp" android:color="#1E4878" />
            <corners android:radius="26dp" />
        </shape>
    </item>

</layer-list>
