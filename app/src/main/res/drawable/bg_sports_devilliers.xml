<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base premium gradient -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:startColor="#1B5E20"
                android:centerColor="#FFEB3B"
                android:endColor="#D50000"
                android:angle="225" />
        </shape>
    </item>
    <!-- Overlay for glow -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:startColor="#40FFFFFF"
                android:endColor="#00000000"
                android:angle="90" />
        </shape>
    </item>
</layer-list>
