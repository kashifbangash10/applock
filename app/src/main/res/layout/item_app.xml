<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="20dp"
    android:layout_marginVertical="4dp"
    android:background="@drawable/bg_app_row_dark"
    android:clickable="true"
    android:focusable="true">

    <!-- App Icon Container with Soft UI Gradient/Border -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardIcon"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:layout_marginStart="14dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/bg_card_elevated"
        app:strokeWidth="1dp"
        app:strokeColor="@color/card_border"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageView
            android:id="@+id/ivAppIcon"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="center"
            android:contentDescription="App Icon"
            tools:src="@drawable/ic_launcher_foreground"/>

    </com.google.android.material.card.MaterialCardView>

    <!-- App Information -->
    <TextView
        android:id="@+id/tvAppName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:textColor="@color/text_primary"
        android:textSize="15sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium"
        app:layout_constraintStart_toEndOf="@id/cardIcon"
        app:layout_constraintEnd_toStartOf="@id/btnLockToggle"
        app:layout_constraintTop_toTopOf="@id/cardIcon"
        app:layout_constraintBottom_toTopOf="@id/tvAppType"
        tools:text="Google Play Store"/>

    <TextView
        android:id="@+id/tvAppType"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:layout_marginTop="2dp"
        app:layout_constraintStart_toStartOf="@id/tvAppName"
        app:layout_constraintEnd_toEndOf="@id/tvAppName"
        app:layout_constraintTop_toBottomOf="@id/tvAppName"
        app:layout_constraintBottom_toBottomOf="@id/cardIcon"
        tools:text="System Application"/>

    <!-- Interactive Lock Button -->
    <ImageButton
        android:id="@+id/btnLockToggle"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginEnd="14dp"
        android:background="@drawable/bg_lock_circle_dark"
        android:padding="7dp"
        android:contentDescription="Lock status toggle"
        android:scaleType="centerInside"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:src="@drawable/ic_lock_closed"/>

    <!-- Divider line (hidden in card mode) -->
    <View
        android:id="@+id/divider"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
