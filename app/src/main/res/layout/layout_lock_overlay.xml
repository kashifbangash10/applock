<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootOverlayLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:padding="24dp">

    <!-- Exit button (hidden - removed per design) -->
    <ImageView
        android:id="@+id/btnOverlayExit"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:src="@drawable/ic_close"
        android:contentDescription="Close"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Title -->
    <TextView
        android:id="@+id/tvOverlayLockedTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Application Locked"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"/>

    <!-- App Icon Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardOverlayIcon"
        android:layout_width="88dp"
        android:layout_height="88dp"
        android:layout_marginTop="32dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/bg_card_elevated"
        app:strokeWidth="1dp"
        app:strokeColor="@color/card_border"
        app:layout_constraintTop_toBottomOf="@id/tvOverlayLockedTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/imgOverlayAppIcon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:src="@android:drawable/sym_def_app_icon"
            android:contentDescription="Locked App Icon" />
    </com.google.android.material.card.MaterialCardView>

    <!-- App Name -->
    <TextView
        android:id="@+id/tvOverlayAppName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Locked App"
        android:textColor="@color/text_primary"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/cardOverlayIcon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Status / hint text -->
    <TextView
        android:id="@+id/tvOverlayAppStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Draw your unlock pattern to access"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        app:layout_constraintTop_toBottomOf="@id/tvOverlayAppName"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Fingerprint Option Button Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardFingerprint"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginTop="16dp"
        app:cardCornerRadius="32dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="@color/primary"
        app:strokeWidth="0dp"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/tvOverlayAppStatus"
        app:layout_constraintBottom_toTopOf="@id/overlayInputContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/btnFingerprintAuth"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp"
            android:src="@drawable/ic_fingerprint"
            android:contentDescription="Fingerprint Unlock"
            app:tint="@color/white" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Interactive Input Container -->
    <FrameLayout
        android:id="@+id/overlayInputContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/cardFingerprint"
        app:layout_constraintBottom_toTopOf="@id/tvOverlayForgotPassword"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.applockerapp.presentation.customview.PatternLockView
            android:id="@+id/overlayPatternView"
            android:layout_width="300dp"
            android:layout_height="300dp"
            android:layout_gravity="center" />

        <include
            android:id="@+id/includeOverlayPinInput"
            layout="@layout/layout_pin_input"
            android:visibility="gone" />

        <include
            android:id="@+id/includeOverlayPasswordInput"
            layout="@layout/layout_password_input"
            android:visibility="gone" />

    </FrameLayout>

    <!-- Intruder Captured Banner Container -->
    <FrameLayout
        android:id="@+id/intruderBannerContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/tvOverlayForgotPassword"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="8dp">

        <include layout="@layout/layout_intruder_banner" />
    </FrameLayout>

    <!-- Forgot Password -->
    <TextView
        android:id="@+id/tvOverlayForgotPassword"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Forgot Password?"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:padding="8dp"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackground"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="8dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>
