<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="8dp">

    <!-- PIN Indicators (4 circular dots) -->
    <LinearLayout
        android:id="@+id/layoutPinDots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="24dp">

        <View
            android:id="@+id/dot1"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_margin="8dp"
            android:background="@drawable/bg_pin_dot_empty"/>

        <View
            android:id="@+id/dot2"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_margin="8dp"
            android:background="@drawable/bg_pin_dot_empty"/>

        <View
            android:id="@+id/dot3"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_margin="8dp"
            android:background="@drawable/bg_pin_dot_empty"/>

        <View
            android:id="@+id/dot4"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_margin="8dp"
            android:background="@drawable/bg_pin_dot_empty"/>

    </LinearLayout>

    <!-- Keypad Layout -->
    <TableLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:stretchColumns="*"
        android:gravity="center">

        <!-- Row 1: 1, 2, 3 -->
        <TableRow
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnKey1"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:text="1"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:layout_marginHorizontal="12dp"
                app:cornerRadius="32dp"
                app:backgroundTint="@color/bg_card_highlight"
                style="@style/Widget.Material3.Button.ElevatedButton"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnKey2"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:text="2"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:layout_marginHorizontal="12dp"
                app:cornerRadius="32dp"
                app:backgroundTint="@color/bg_card_highlight"
                style="@style/Widget.Material3.Button.ElevatedButton"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnKey3"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:text="3"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:layout_marginHorizontal="12dp"
                app:cornerRadius="32dp"
                app:backgroundTint="@color/bg_card_highlight"
                style="@style/Widget.Material3.Button.ElevatedButton"/>
        </TableRow>

        <!-- Row 2: 4, 5, 6 -->
        <TableRow
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnKey4"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:text="4"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:layout_marginHorizontal="12dp"
                app:cornerRadius="32dp"
                app:backgroundTint="@color/bg_card_highlight"
                style="@style/Widget.Material3.Button.ElevatedButton"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnKey5"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:text="5"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:layout_marginHorizontal="12dp"
                app:cornerRadius="32dp"
                app:backgroundTint="@color/bg_card_highlight"
                style="@style/Widget.Material3.Button.ElevatedButton"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnKey6"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:text="6"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:layout_marginHorizontal="12dp"
                app:cornerRadius="32dp"
                app:backgroundTint="@color/bg_card_highlight"
                style="@style/Widget.Material3.Button.ElevatedButton"/>
        </TableRow>

        <!-- Row 3: 7, 8, 9 -->
        <TableRow
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnKey7"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:text="7"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:layout_marginHorizontal="12dp"
                app:cornerRadius="32dp"
                app:backgroundTint="@color/bg_card_highlight"
                style="@style/Widget.Material3.Button.ElevatedButton"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnKey8"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:text="8"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:layout_marginHorizontal="12dp"
                app:cornerRadius="32dp"
                app:backgroundTint="@color/bg_card_highlight"
                style="@style/Widget.Material3.Button.ElevatedButton"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnKey9"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:text="9"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:layout_marginHorizontal="12dp"
                app:cornerRadius="32dp"
                app:backgroundTint="@color/bg_card_highlight"
                style="@style/Widget.Material3.Button.ElevatedButton"/>
        </TableRow>

        <!-- Row 4: Delete, 0, Confirm -->
        <TableRow
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnKeyDelete"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginHorizontal="12dp"
                app:cornerRadius="32dp"
                app:backgroundTint="@color/bg_card_highlight"
                app:icon="@drawable/ic_close"
                app:iconGravity="textStart"
                app:iconSize="24dp"
                app:iconTint="@color/text_primary"
                style="@style/Widget.Material3.Button.ElevatedButton"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnKey0"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:text="0"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:layout_marginHorizontal="12dp"
                app:cornerRadius="32dp"
                app:backgroundTint="@color/bg_card_highlight"
                style="@style/Widget.Material3.Button.ElevatedButton"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnKeyConfirm"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginHorizontal="12dp"
                app:cornerRadius="32dp"
                app:backgroundTint="@color/primary"
                app:icon="@drawable/ic_lock_closed"
                app:iconGravity="textStart"
                app:iconSize="24dp"
                app:iconTint="@color/white"
                style="@style/Widget.Material3.Button.ElevatedButton"/>
        </TableRow>

    </TableLayout>

</LinearLayout>
