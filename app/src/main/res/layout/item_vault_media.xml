<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="3dp">

    <!-- Square card with rounded corners and subtle border -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/mediaCard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="@color/bg_card_elevated"
        app:strokeWidth="0dp"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Media Thumbnail -->
            <ImageView
                android:id="@+id/imgMediaThumb"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:background="@color/bg_card_elevated"
                android:contentDescription="Media thumbnail"/>

            <!-- Video play icon gradient scrim at bottom -->
            <View
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_gravity="bottom"
                android:background="#44000000"
                android:visibility="gone"
                android:id="@+id/viewVideoScrim"/>

            <!-- Play Icon for Videos -->
            <ImageView
                android:id="@+id/imgPlayOverlay"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_video"
                app:tint="@color/white"
                android:visibility="gone"
                android:contentDescription="Play video"
                android:alpha="0.9"
                android:background="@null"/>

            <!-- Selection Dim Overlay -->
            <View
                android:id="@+id/viewSelectionDim"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#55000000"
                android:visibility="gone"/>

            <!-- Circle Outline (Unselected) -->
            <ImageView
                android:id="@+id/imgSelectionOutline"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="top|end"
                android:layout_margin="8dp"
                android:src="@drawable/ic_circle_outline"
                android:visibility="gone"
                android:contentDescription="Unselected"/>

            <!-- Check Circle (Selected) -->
            <ImageView
                android:id="@+id/imgSelectionChecked"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="top|end"
                android:layout_margin="8dp"
                android:src="@drawable/ic_check_circle"
                android:visibility="gone"
                android:contentDescription="Selected"/>

        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
