<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_home_wallpaper">

    <!-- Header Toolbar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/toolbarSettings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingVertical="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBackSettings"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="Go Back"
            app:tint="@color/text_primary"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_settings"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginStart="16dp"
            app:layout_constraintStart_toEndOf="@id/btnBackSettings"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Scrollable Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/toolbarSettings"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp">

            <!-- ==================== PRIVACY SECTION ==================== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginBottom="8dp"
                android:text="SECURITY"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:textSize="13sp"/>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#0F1C30"
                app:strokeWidth="1dp"
                app:strokeColor="#2538BDF8">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp">

                    <!-- Fingerprint Unlock -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="60dp">

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/iconContainerFingerprint"
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:layout_centerVertical="true"
                            app:cardCornerRadius="10dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="@color/bg_card_elevated"
                            app:strokeWidth="1dp"
                            app:strokeColor="@color/card_border">
                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_fingerprint"
                                app:tint="@color/icon_accent_emerald"/>
                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:id="@+id/tvFingerprintTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_toEndOf="@id/iconContainerFingerprint"
                            android:layout_toStartOf="@+id/switchFingerprint"
                            android:layout_marginStart="14dp"
                            android:layout_centerVertical="true"
                            android:text="Fingerprint unlock"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp"
                            android:textStyle="normal"/>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchFingerprint"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            app:thumbTint="@color/switch_thumb_tint"
                            app:trackTint="@color/switch_track_tint"/>
                    </RelativeLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:background="@color/card_border"/>

                    <!-- Change Password -->
                    <RelativeLayout
                        android:id="@+id/rlChangePass"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground">

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/iconContainerChangePass"
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:layout_centerVertical="true"
                            app:cardCornerRadius="10dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="@color/bg_card_elevated"
                            app:strokeWidth="1dp"
                            app:strokeColor="@color/card_border">
                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_key"
                                app:tint="@color/primary"/>
                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_toEndOf="@id/iconContainerChangePass"
                            android:layout_toStartOf="@+id/arrowChangePass"
                            android:layout_marginStart="14dp"
                            android:layout_centerVertical="true"
                            android:text="Change Password"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp"/>

                        <ImageView
                            android:id="@+id/arrowChangePass"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:src="@drawable/ic_arrow_forward"
                            app:tint="@color/text_muted"/>
                    </RelativeLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:background="@color/card_border"/>

                    <!-- Password Type -->
                    <RelativeLayout
                        android:id="@+id/rlPasswordType"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground">

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/iconContainerPasswordType"
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:layout_centerVertical="true"
                            app:cardCornerRadius="10dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="@color/bg_card_elevated"
                            app:strokeWidth="1dp"
                            app:strokeColor="@color/card_border">
                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_shield"
                                app:tint="@color/icon_accent_emerald"/>
                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_toEndOf="@id/iconContainerPasswordType"
                            android:layout_toStartOf="@+id/arrowPasswordType"
                            android:layout_marginStart="14dp"
                            android:layout_centerVertical="true"
                            android:text="Password Type"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp"/>

                        <ImageView
                            android:id="@+id/arrowPasswordType"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:src="@drawable/ic_arrow_forward"
                            app:tint="@color/text_muted"/>
                    </RelativeLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:background="@color/card_border"/>

                    <!-- Security Question -->
                    <RelativeLayout
                        android:id="@+id/rlSecurityQuestion"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground">

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/iconContainerSecurityQuestion"
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:layout_centerVertical="true"
                            app:cardCornerRadius="10dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="@color/bg_card_elevated"
                            app:strokeWidth="1dp"
                            app:strokeColor="@color/card_border">
                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_help"
                                app:tint="@color/primary"/>
                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_toEndOf="@id/iconContainerSecurityQuestion"
                            android:layout_toStartOf="@+id/arrowSecurityQuestion"
                            android:layout_marginStart="14dp"
                            android:layout_centerVertical="true"
                            android:text="Security Question"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp"/>

                        <ImageView
                            android:id="@+id/arrowSecurityQuestion"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:src="@drawable/ic_arrow_forward"
                            app:tint="@color/text_muted"/>
                    </RelativeLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:background="@color/card_border"/>

                    <!-- Change App Icon -->
                    <RelativeLayout
                        android:id="@+id/rlChangeAppIcon"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground">

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/iconContainerChangeAppIcon"
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:layout_centerVertical="true"
                            app:cardCornerRadius="10dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="@color/bg_card_elevated"
                            app:strokeWidth="1dp"
                            app:strokeColor="@color/card_border">
                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_palette"
                                app:tint="@color/primary"/>
                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_toEndOf="@id/iconContainerChangeAppIcon"
                            android:layout_toStartOf="@+id/arrowChangeAppIcon"
                            android:layout_marginStart="14dp"
                            android:layout_centerVertical="true"
                            android:text="Change App Icon"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp"/>

                        <ImageView
                            android:id="@+id/arrowChangeAppIcon"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:src="@drawable/ic_arrow_forward"
                            app:tint="@color/text_muted"/>
                    </RelativeLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:background="@color/card_border"/>

                    <!-- Lock Screen Settings -->
                    <RelativeLayout
                        android:id="@+id/rlLockScreenSettings"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground">

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/iconContainerLockScreenSettings"
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:layout_centerVertical="true"
                            app:cardCornerRadius="10dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="@color/bg_card_elevated"
                            app:strokeWidth="1dp"
                            app:strokeColor="@color/card_border">
                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_shield"
                                app:tint="@color/primary"/>
                        </com.google.android.material.card.MaterialCardView>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_toEndOf="@id/iconContainerLockScreenSettings"
                            android:layout_toStartOf="@+id/arrowLockScreenSettings"
                            android:layout_marginStart="14dp"
                            android:layout_centerVertical="true">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Lock Screen Settings"
                                android:textColor="@color/text_primary"
                                android:textSize="15sp"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Customize lock screen"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp"/>
                        </LinearLayout>

                        <ImageView
                            android:id="@+id/arrowLockScreenSettings"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:src="@drawable/ic_arrow_forward"
                            app:tint="@color/text_muted"/>
                    </RelativeLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ==================== PROTECTION SECTION ==================== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginBottom="8dp"
                android:text="PROTECTION"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:textSize="13sp"/>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#0F1C30"
                app:strokeWidth="1dp"
                app:strokeColor="#2538BDF8">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp">

                    <!-- Uninstall Protection -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="60dp">

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/iconContainerUninstallProtection"
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:layout_centerVertical="true"
                            app:cardCornerRadius="10dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="@color/bg_card_elevated"
                            app:strokeWidth="1dp"
                            app:strokeColor="@color/card_border">
                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_delete"
                                app:tint="@color/primary"/>
                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_toEndOf="@id/iconContainerUninstallProtection"
                            android:layout_toStartOf="@+id/switchUninstallProtection"
                            android:layout_marginStart="14dp"
                            android:layout_centerVertical="true"
                            android:text="Uninstall Protection"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp"/>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchUninstallProtection"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            app:thumbTint="@color/switch_thumb_tint"
                            app:trackTint="@color/switch_track_tint"/>
                    </RelativeLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:background="@color/card_border"/>

                    <!-- Screenshot Protection -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="60dp">

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/iconContainerScreenshotProtection"
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:layout_centerVertical="true"
                            app:cardCornerRadius="10dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="@color/bg_card_elevated"
                            app:strokeWidth="1dp"
                            app:strokeColor="@color/card_border">
                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_camera"
                                app:tint="@color/primary"/>
                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_toEndOf="@id/iconContainerScreenshotProtection"
                            android:layout_toStartOf="@+id/switchScreenshotProtection"
                            android:layout_marginStart="14dp"
                            android:layout_centerVertical="true"
                            android:text="Screenshot Protection"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp"/>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchScreenshotProtection"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            app:thumbTint="@color/switch_thumb_tint"
                            app:trackTint="@color/switch_track_tint"/>
                    </RelativeLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:background="@color/card_border"/>

                    <!-- Failed Attempts Lockout -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="60dp">

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/iconContainerFailedLockout"
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:layout_centerVertical="true"
                            app:cardCornerRadius="10dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="@color/bg_card_elevated"
                            app:strokeWidth="1dp"
                            app:strokeColor="@color/card_border">
                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_lock_closed"
                                app:tint="@color/primary"/>
                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_toEndOf="@id/iconContainerFailedLockout"
                            android:layout_toStartOf="@+id/switchFailedLockout"
                            android:layout_marginStart="14dp"
                            android:layout_centerVertical="true"
                            android:text="Failed Attempts Lockout"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp"/>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchFailedLockout"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            app:thumbTint="@color/switch_thumb_tint"
                            app:trackTint="@color/switch_track_tint"/>
                    </RelativeLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ==================== SMART LOCK SECTION ==================== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginBottom="8dp"
                android:text="SMART LOCK"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:textSize="13sp"/>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#0F1C30"
                app:strokeWidth="1dp"
                app:strokeColor="#2538BDF8">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp">

                    <!-- App lock -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="60dp">

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/iconContainerAppLock"
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:layout_centerVertical="true"
                            app:cardCornerRadius="10dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="@color/bg_card_elevated"
                            app:strokeWidth="1dp"
                            app:strokeColor="@color/card_border">
                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_settings"
                                app:tint="@color/primary"/>
                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_toEndOf="@id/iconContainerAppLock"
                            android:layout_toStartOf="@+id/switchAppLock"
                            android:layout_marginStart="14dp"
                            android:layout_centerVertical="true"
                            android:text="App lock"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp"/>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchAppLock"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            app:thumbTint="@color/switch_thumb_tint"
                            app:trackTint="@color/switch_track_tint"/>
                    </RelativeLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>


            <!-- ==================== OTHERS SECTION ==================== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="8dp"
                android:text="OTHERS"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:textSize="13sp"/>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#0F1C30"
                app:strokeWidth="1dp"
                app:strokeColor="#2538BDF8">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <!-- Language -->
                    <RelativeLayout
                        android:id="@+id/rlLanguage"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:background="?attr/selectableItemBackground"
                        android:paddingHorizontal="8dp">

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/iconContainerLanguage"
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:layout_centerVertical="true"
                            app:cardCornerRadius="10dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="@color/bg_card_elevated"
                            app:strokeWidth="1dp"
                            app:strokeColor="@color/card_border">
                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_language"
                                app:tint="@color/primary"/>
                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_toEndOf="@id/iconContainerLanguage"
                            android:layout_marginStart="14dp"
                            android:layout_centerVertical="true"
                            android:text="Language"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp"/>

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:src="@drawable/ic_arrow_forward"
                            app:tint="@color/text_muted"/>
                    </RelativeLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:layout_marginHorizontal="8dp"
                        android:background="@color/card_border"/>

                    <!-- Rate Us -->
                    <RelativeLayout
                        android:id="@+id/rlRateUs"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:background="?attr/selectableItemBackground"
                        android:paddingHorizontal="8dp">

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/iconContainerRateUs"
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:layout_centerVertical="true"
                            app:cardCornerRadius="10dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="@color/bg_card_elevated"
                            app:strokeWidth="1dp"
                            app:strokeColor="@color/card_border">
                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_star"
                                app:tint="@color/primary"/>
                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_toEndOf="@id/iconContainerRateUs"
                            android:layout_marginStart="14dp"
                            android:layout_centerVertical="true"
                            android:text="Rate Us"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp"/>

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:src="@drawable/ic_arrow_forward"
                            app:tint="@color/text_muted"/>
                    </RelativeLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:layout_marginHorizontal="8dp"
                        android:background="@color/card_border"/>

                    <!-- Share -->
                    <RelativeLayout
                        android:id="@+id/rlShare"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:background="?attr/selectableItemBackground"
                        android:paddingHorizontal="8dp">

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/iconContainerShare"
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:layout_centerVertical="true"
                            app:cardCornerRadius="10dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="@color/bg_card_elevated"
                            app:strokeWidth="1dp"
                            app:strokeColor="@color/card_border">
                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_share"
                                app:tint="@color/primary"/>
                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_toEndOf="@id/iconContainerShare"
                            android:layout_marginStart="14dp"
                            android:layout_centerVertical="true"
                            android:text="Share"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp"/>

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:src="@drawable/ic_arrow_forward"
                            app:tint="@color/text_muted"/>
                    </RelativeLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:layout_marginHorizontal="8dp"
                        android:background="@color/card_border"/>

                    <!-- Privacy Policy -->
                    <RelativeLayout
                        android:id="@+id/rlPrivacyPolicy"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:background="?attr/selectableItemBackground"
                        android:paddingHorizontal="8dp">

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/iconContainerPrivacyPolicy"
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:layout_centerVertical="true"
                            app:cardCornerRadius="10dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="@color/bg_card_elevated"
                            app:strokeWidth="1dp"
                            app:strokeColor="@color/card_border">
                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_privacy_policy"
                                app:tint="@color/icon_accent_emerald"/>
                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_toEndOf="@id/iconContainerPrivacyPolicy"
                            android:layout_marginStart="14dp"
                            android:layout_centerVertical="true"
                            android:text="Privacy Policy"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp"/>

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:src="@drawable/ic_arrow_forward"
                            app:tint="@color/text_muted"/>
                    </RelativeLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- bottom padding -->
            <View
                android:layout_width="match_parent"
                android:layout_height="32dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
