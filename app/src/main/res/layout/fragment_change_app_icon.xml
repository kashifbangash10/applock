<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main">

    <!-- Header Toolbar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/toolbarChangeIcon"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingVertical="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBackChangeIcon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="Go Back"
            app:tint="@color/text_primary"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Change App Icon"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginStart="16dp"
            app:layout_constraintStart_toEndOf="@id/btnBackChangeIcon"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <TextView
            android:id="@+id/btnResetIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Reset"
            android:textColor="@color/primary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground"
            android:padding="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Scrollable Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="88dp"
        app:layout_constraintTop_toBottomOf="@id/toolbarChangeIcon"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp">

            <!-- Current Icon Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="28dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/bg_card_elevated"
                app:strokeWidth="1dp"
                app:strokeColor="@color/card_border">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="18dp">

                    <!-- Current icon preview -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardCurrentIcon"
                        android:layout_width="58dp"
                        android:layout_height="58dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="#FF0D47A1"
                        app:strokeWidth="1.5dp"
                        app:strokeColor="@color/primary">
                        <ImageView
                            android:id="@+id/imgCurrentIcon"
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_launcher_default_premium"
                            android:scaleType="fitCenter"/>
                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Current Icon"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Disguise this as another app icon on home screen"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            android:lineSpacingMultiplier="1.3"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===== CALCULATOR SECTION ===== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Calculator"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="14dp"/>

            <!-- Calculator Icons Row - centered with equal side padding -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="28dp">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/choiceCalcTeal"
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:layout_marginHorizontal="7dp"
                    app:cardCornerRadius="17dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="#FF00897B"
                    app:strokeWidth="0dp">
                    <ImageView
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_fg_calc"/>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/choiceCalcPurple"
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:layout_marginHorizontal="7dp"
                    app:cardCornerRadius="17dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="#FF7B1FA2"
                    app:strokeWidth="3dp"
                    app:strokeColor="@android:color/transparent">
                    <ImageView
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_fg_calc"/>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/choiceCalcBlue"
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:layout_marginHorizontal="7dp"
                    app:cardCornerRadius="17dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="#FF1976D2"
                    app:strokeWidth="0dp">
                    <ImageView
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_fg_calc"/>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/choiceCalcPink"
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:layout_marginHorizontal="7dp"
                    app:cardCornerRadius="17dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="#FFE91E63"
                    app:strokeWidth="0dp">
                    <ImageView
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_fg_calc"/>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- ===== WEATHER SECTION ===== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Weather"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="14dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="28dp">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/choiceWeatherBlue"
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:layout_marginHorizontal="7dp"
                    app:cardCornerRadius="17dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="#FF0288D1"
                    app:strokeWidth="0dp">
                    <ImageView
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_fg_weather"/>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/choiceWeatherPurple"
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:layout_marginHorizontal="7dp"
                    app:cardCornerRadius="17dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="#FF512DA8"
                    app:strokeWidth="0dp">
                    <ImageView
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_fg_weather"/>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/choiceWeatherGreen"
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:layout_marginHorizontal="7dp"
                    app:cardCornerRadius="17dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="#FF2E7D32"
                    app:strokeWidth="0dp">
                    <ImageView
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_fg_weather"/>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/choiceWeatherCyan"
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:layout_marginHorizontal="7dp"
                    app:cardCornerRadius="17dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="#FF00838F"
                    app:strokeWidth="0dp">
                    <ImageView
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_fg_weather"/>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- ===== RECORDER SECTION ===== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Recorder"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="14dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="28dp">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/choiceRecCyan"
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:layout_marginHorizontal="7dp"
                    app:cardCornerRadius="17dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="#FF00ACC1"
                    app:strokeWidth="0dp">
                    <ImageView
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_fg_recorder"/>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/choiceRecViolet"
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:layout_marginHorizontal="7dp"
                    app:cardCornerRadius="17dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="#FF6200EE"
                    app:strokeWidth="0dp">
                    <ImageView
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_fg_recorder"/>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/choiceRecGold"
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:layout_marginHorizontal="7dp"
                    app:cardCornerRadius="17dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="#FFF9A825"
                    app:strokeWidth="0dp">
                    <ImageView
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_fg_recorder"/>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/choiceRecOrange"
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:layout_marginHorizontal="7dp"
                    app:cardCornerRadius="17dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="#FFE64A19"
                    app:strokeWidth="0dp">
                    <ImageView
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_fg_recorder"/>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- ===== MUSIC SECTION ===== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Music"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="14dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="32dp">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/choiceMusicPink"
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:layout_marginHorizontal="7dp"
                    app:cardCornerRadius="17dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="#FFE91E63"
                    app:strokeWidth="0dp">
                    <ImageView
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_fg_music"/>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/choiceMusicGreen"
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:layout_marginHorizontal="7dp"
                    app:cardCornerRadius="17dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="#FF388E3C"
                    app:strokeWidth="0dp">
                    <ImageView
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_fg_music"/>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/choiceMusicIndigo"
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:layout_marginHorizontal="7dp"
                    app:cardCornerRadius="17dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="#FF303F9F"
                    app:strokeWidth="0dp">
                    <ImageView
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_fg_music"/>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/choiceMusicAmber"
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:layout_marginHorizontal="7dp"
                    app:cardCornerRadius="17dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="#FFFFA000"
                    app:strokeWidth="0dp">
                    <ImageView
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_fg_music"/>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Apply Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnApplyIcon"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="20dp"
        android:text="Apply"
        style="@style/Widget.AppLockerApp.Button.Primary3D"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
