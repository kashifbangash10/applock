<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_home_wallpaper">

    <!-- Header Toolbar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/toolbarIntruder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingVertical="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBackIntruder"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="Go Back"
            app:tint="@color/text_primary"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_intruder_selfie"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginStart="16dp"
            app:layout_constraintStart_toEndOf="@id/btnBackIntruder"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Scrollable Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/toolbarIntruder"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp">

            <!-- Toggle Switch Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardCaptureSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/bg_card_elevated"
                app:strokeWidth="1dp"
                app:strokeColor="@color/card_border">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="20dp">

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchCapture"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        app:thumbTint="@color/switch_thumb_tint"
                        app:trackTint="@color/switch_track_tint"/>

                    <TextView
                        android:id="@+id/tvToggleTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_toStartOf="@id/switchCapture"
                        android:layout_marginEnd="16dp"
                        android:text="@string/setting_capture_intruder"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/tvToggleTitle"
                        android:layout_toStartOf="@id/switchCapture"
                        android:layout_marginTop="4dp"
                        android:layout_marginEnd="16dp"
                        android:text="@string/setting_capture_intruder_desc"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"/>

                </RelativeLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Attempt Limit Selector Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAttemptLimit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/bg_card_elevated"
                app:strokeWidth="1dp"
                app:strokeColor="@color/card_border">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/setting_attempt_limit"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold"/>

                    <!-- Attempt limit chip choices -->
                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupAttempts"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        app:singleSelection="true"
                        app:checkedChip="@+id/chipAttempt1">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipAttempt1"
                            style="@style/Widget.Material3.Chip.Suggestion"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/attempt_limit_1"
                            android:textColor="@color/text_primary"
                            app:chipBackgroundColor="@color/bg_card_elevated"
                            app:chipStrokeColor="@color/card_border"/>

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipAttempt2"
                            style="@style/Widget.Material3.Chip.Suggestion"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/attempt_limit_2"
                            android:textColor="@color/text_primary"
                            app:chipBackgroundColor="@color/bg_card_elevated"
                            app:chipStrokeColor="@color/card_border"/>

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipAttempt3"
                            style="@style/Widget.Material3.Chip.Suggestion"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/attempt_limit_3"
                            android:textColor="@color/text_primary"
                            app:chipBackgroundColor="@color/bg_card_elevated"
                            app:chipStrokeColor="@color/card_border"/>

                    </com.google.android.material.chip.ChipGroup>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Intruder Photos Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginBottom="12dp"
                android:text="@string/setting_intruders_gallery"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <!-- Empty Gallery State -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardEmptyGallery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/bg_card_elevated"
                app:strokeWidth="1dp"
                app:strokeColor="@color/card_border"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="32dp">

                    <ImageView
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:src="@drawable/ic_camera"
                        app:tint="@color/text_muted"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/no_intruders_title"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/no_intruders_desc"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:gravity="center"/>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Grid of Photos (Simulated Intruder Snapshots) -->
            <GridLayout
                android:id="@+id/gridIntruders"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:rowCount="1"
                android:layout_marginBottom="24dp"
                android:visibility="visible">

                <!-- Mock Photo 1 -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardPhoto1"
                    android:layout_width="0dp"
                    android:layout_height="140dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/bg_card_elevated"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/card_border"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/ivIntruder1"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_gallery"
                        android:contentDescription="Intruder Photo 1"/>

                    <!-- Time overlay label -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|center_horizontal"
                        android:layout_marginBottom="8dp"
                        android:background="#A0000000"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="2dp"
                        android:text="May 30, 10:24 AM"
                        android:textColor="@color/white"
                        android:textSize="10sp"/>
                </com.google.android.material.card.MaterialCardView>

                <!-- Mock Photo 2 -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardPhoto2"
                    android:layout_width="0dp"
                    android:layout_height="140dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/bg_card_elevated"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/card_border"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/ivIntruder2"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_gallery"
                        android:contentDescription="Intruder Photo 2"/>

                    <!-- Time overlay label -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|center_horizontal"
                        android:layout_marginBottom="8dp"
                        android:background="#A0000000"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="2dp"
                        android:text="May 29, 08:15 PM"
                        android:textColor="@color/white"
                        android:textSize="10sp"/>
                </com.google.android.material.card.MaterialCardView>

            </GridLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
