<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="20dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/bg_surface"
        app:cardCornerRadius="24dp"
        app:cardElevation="16dp"
        app:strokeColor="@color/card_stroke_emerald"
        app:strokeWidth="1.5dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingHorizontal="24dp"
            android:paddingTop="28dp"
            android:paddingBottom="24dp">

            <!-- ── Top Thumbs Up Feedback Badge ── -->
            <FrameLayout
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:background="@drawable/bg_circle_button"
                android:elevation="4dp">

                <ImageView
                    android:id="@+id/imgRateHeader"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_rate_thumbs_up"
                    android:contentDescription="Rate Us Icon" />
            </FrameLayout>

            <!-- ── Title ── -->
            <TextView
                android:id="@+id/tvRateTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Thank you for using our app"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold"
                android:gravity="center"
                android:fontFamily="sans-serif-black"
                android:layout_marginTop="16dp" />

            <!-- ── Subtitle ── -->
            <TextView
                android:id="@+id/tvRateSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Please Give Us Some Feedback To Help Us Improve"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:layout_marginTop="8dp" />

            <!-- ── 5 Interactive Stars Row ── -->
            <LinearLayout
                android:id="@+id/layoutStarsRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="24dp">

                <ImageView
                    android:id="@+id/star1"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:padding="4dp"
                    android:src="@drawable/ic_star_outline"
                    app:tint="@color/text_muted"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="1 Star" />

                <ImageView
                    android:id="@+id/star2"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:padding="4dp"
                    android:src="@drawable/ic_star_outline"
                    app:tint="@color/text_muted"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="2 Stars"
                    android:layout_marginStart="8dp" />

                <ImageView
                    android:id="@+id/star3"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:padding="4dp"
                    android:src="@drawable/ic_star_outline"
                    app:tint="@color/text_muted"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="3 Stars"
                    android:layout_marginStart="8dp" />

                <ImageView
                    android:id="@+id/star4"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:padding="4dp"
                    android:src="@drawable/ic_star_outline"
                    app:tint="@color/text_muted"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="4 Stars"
                    android:layout_marginStart="8dp" />

                <ImageView
                    android:id="@+id/star5"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:padding="4dp"
                    android:src="@drawable/ic_star_outline"
                    app:tint="@color/text_muted"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="5 Stars"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <!-- ── Action Buttons ── -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnRateNow"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/btn_gradient_primary_3d"
                android:text="Rate now"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:elevation="6dp" />

            <TextView
                android:id="@+id/btnNotNow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Not Now"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:paddingVertical="12dp"
                android:paddingHorizontal="24dp"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginTop="8dp" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</FrameLayout>
