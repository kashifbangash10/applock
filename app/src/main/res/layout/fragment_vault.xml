<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_home_wallpaper">

    <!-- ===== HEADER TOOLBAR ===== -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/toolbarVault"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Back Button with circular glass container -->
        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <ImageButton
                android:id="@+id/btnBackVault"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_circle_button"
                android:src="@drawable/ic_arrow_back"
                android:contentDescription="Back"
                app:tint="@color/text_primary" />
        </FrameLayout>

        <!-- Title & Subtitle Container -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="56dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Vault"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold"
                android:letterSpacing="0.02" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Private Storage"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:letterSpacing="0.03" />
        </LinearLayout>

        <!-- Security Badge -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_badge_outline"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_shield"
                app:tint="@color/primary"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Secured"
                android:textColor="@color/primary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginStart="4dp"/>
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ===== TABS CONTAINER CARD ===== -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/tabContainerCard"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="4dp"
        app:cardCornerRadius="14dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="@color/bg_card_elevated"
        app:strokeWidth="1dp"
        app:strokeColor="@color/card_border"
        app:layout_constraintTop_toBottomOf="@id/toolbarVault">

        <LinearLayout
            android:id="@+id/tabRow"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:weightSum="2">

            <TextView
                android:id="@+id/tabImages"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Photos"
                android:textColor="@color/primary"
                android:textSize="15sp"
                android:textStyle="bold"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:id="@+id/tabVideos"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Videos"
                android:textColor="@color/text_secondary"
                android:textSize="15sp"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"/>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Tab Indicator line -->
    <View
        android:id="@+id/vaultTabIndicator"
        android:layout_width="0dp"
        android:layout_height="3dp"
        android:background="@drawable/pill_active_gradient"
        app:layout_constraintTop_toBottomOf="@id/tabContainerCard"
        app:layout_constraintStart_toStartOf="@id/tabContainerCard"
        app:layout_constraintEnd_toEndOf="@id/tabContainerCard"/>

    <!-- Separator line -->
    <View
        android:id="@+id/tabDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="6dp"
        android:background="@color/card_border"
        app:layout_constraintTop_toBottomOf="@id/vaultTabIndicator"/>

    <!-- ===== EMPTY STATE (shown when vault has no files) ===== -->
    <LinearLayout
        android:id="@+id/layoutVaultEmpty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingHorizontal="24dp"
        android:visibility="visible"
        app:layout_constraintTop_toBottomOf="@id/tabDivider"
        app:layout_constraintBottom_toTopOf="@id/bottomActionsCard">

        <!-- Outer glow ring -->
        <FrameLayout
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:layout_gravity="center">

            <!-- Glow circle background -->
            <View
                android:layout_width="180dp"
                android:layout_height="180dp"
                android:background="@drawable/bg_glow_ring_cyan"
                android:layout_gravity="center"/>

            <!-- Inner card circle -->
            <View
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:background="@drawable/bg_circle_button"
                android:layout_gravity="center"/>

            <!-- 3D Safe Vault Premium Icon -->
            <ImageView
                android:id="@+id/imgVaultLock"
                android:layout_width="135dp"
                android:layout_height="135dp"
                android:src="@drawable/ic_vault_premium"
                android:contentDescription="Secure Vault"
                android:scaleType="fitCenter"
                android:layout_gravity="center"/>

        </FrameLayout>

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Vault is Empty"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold"
            android:letterSpacing="0.02"
            android:gravity="center"/>

        <!-- Subtitle -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Import private photos &amp; videos to hide them securely behind PIN or Pattern lock."
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:gravity="center"
            android:lineSpacingExtra="2dp"/>

        <!-- Feature chips -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="18dp"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔒 Hidden from Gallery"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:background="@drawable/bg_badge_outline"/>

            <View
                android:layout_width="8dp"
                android:layout_height="1dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔑 PIN &amp; Pattern Lock"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:background="@drawable/bg_badge_outline"/>

        </LinearLayout>

    </LinearLayout>

    <!-- ===== MEDIA GRID (hidden until files added) ===== -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvVaultMedia"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:padding="8dp"
        android:overScrollMode="never"
        android:clipToPadding="false"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/tabDivider"
        app:layout_constraintBottom_toTopOf="@id/bottomActionsCard"/>

    <!-- ===== BOTTOM SPECIAL ACTIONS BAR WITH 2 PROFESSIONAL BUTTONS ===== -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bottomActionsCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="24dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="16dp"
        app:cardBackgroundColor="@color/bg_card_elevated"
        app:strokeWidth="1.5dp"
        app:strokeColor="@color/card_border"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp"
            android:weightSum="2">

            <!-- SPECIAL BUTTON 1: IMPORT PHOTOS -->
            <FrameLayout
                android:id="@+id/btnImportImages"
                android:layout_width="0dp"
                android:layout_height="66dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_vault_btn_photo"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="12dp">

                    <!-- Glass Icon Ring -->
                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_circle_button">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_gallery"
                            android:contentDescription="Import Photos"
                            app:tint="@color/white" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Import Photos"
                            android:textColor="@color/white"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="+ Add Images"
                            android:textColor="#D0EEFF"
                            android:textSize="10sp"
                            android:layout_marginTop="1dp"/>
                    </LinearLayout>

                </LinearLayout>

            </FrameLayout>

            <!-- SPECIAL BUTTON 2: IMPORT VIDEOS -->
            <FrameLayout
                android:id="@+id/btnImportVideos"
                android:layout_width="0dp"
                android:layout_height="66dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_vault_btn_video"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="12dp">

                    <!-- Glass Icon Ring -->
                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_circle_button">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_video"
                            android:contentDescription="Import Videos"
                            app:tint="@color/primary" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Import Videos"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="+ Add Videos"
                            android:textColor="@color/primary"
                            android:textSize="10sp"
                            android:layout_marginTop="1dp"/>
                    </LinearLayout>

                </LinearLayout>

            </FrameLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
